# Comein NewAPI。复制为 .env 后填 key，不要提交 .env。
OPENAI_API_KEY=sk-your-comein-key
OPENAI_BASE_URL=https://new-api.comein.cn/v1

# 默认走 Responses。gpt-6-luna 支持 none、low、medium、high、xhigh、max，这里用 high。
VALUATION_MODEL=gpt-6-luna
VALUATION_SPLIT_MODEL=gpt-6-luna
VALUATION_REASONING_EFFORT=high
# 可选强制改回 chat
# VALUATION_LLM_API=chat
