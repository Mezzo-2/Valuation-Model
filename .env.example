# Comein NewAPI。复制为 .env 后填 key，不要提交 .env。
OPENAI_API_KEY=sk-your-comein-key
OPENAI_BASE_URL=https://new-api.comein.cn/v1

# 默认日常模型。gpt-5 / luna 走 Responses API；deepseek / glm / qwen 走 Chat Completions。
VALUATION_MODEL=gpt-5.6-luna
VALUATION_SPLIT_MODEL=gpt-5.6-luna
# 可选强制：responses 或 chat
# VALUATION_LLM_API=responses
